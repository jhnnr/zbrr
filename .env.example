# =============================================================================
# AnimeZ (zbrr) Configuration
# Copy this file to .env and fill in your credentials.
# All application configuration is read directly from this .env file.
# Never commit your real .env to version control!
# =============================================================================

# Logging level: trace, debug, info, warn, error
RUST_LOG=zbrr=info

# -----------------------------------------------------------------------------
# General & Pipeline Runtime
# -----------------------------------------------------------------------------
# Base storage directory for state.db, cookies.json, and staging files (default: ~/.zbrr)
ZBRR_DATA_DIR=~/.zbrr
# Background daemon polling interval in seconds (default: 300)
# ZBRR_POLL_INTERVAL_SECS=300
# Maximum releases processed per cycle (default: 5)
# ZBRR_MAX_PER_CYCLE=5
# Global dry-run flag: perform discovery, dupe-check, download, and packaging WITHOUT uploading to animez.to
# ZBRR_DRY_RUN=false
# Request jitter range in milliseconds (polite delays between tracker / external API requests)
# ZBRR_MIN_DELAY_MS=2000
# ZBRR_MAX_DELAY_MS=5000

# -----------------------------------------------------------------------------
# Prowlarr API Settings
# -----------------------------------------------------------------------------
ZBRR_PROWLARR_URL=http://localhost:9696
ZBRR_PROWLARR_API_KEY=your_prowlarr_api_key_here
# Query mode: "api" (/api/v1/search) or "torznab" (/{id}/api?t=rss)
# ZBRR_PROWLARR_MODE=api
# Target indexers to poll for source releases by friendly name (comma-separated, e.g. Nyaa.si,1337x)
ZBRR_PROWLARR_INDEXERS=Nyaa.si
# Or target indexers by numeric ID (comma-separated, e.g. 8; empty = use names in ZBRR_PROWLARR_INDEXERS)
ZBRR_PROWLARR_INDEXER_IDS=
# Indexers to exclude from polling (AnimeZ is excluded by default so it never grabs from itself)
ZBRR_PROWLARR_EXCLUDE_INDEXERS=AnimeZ
# Optional Prowlarr indexer ID configured for animez.to (0 = auto-detect by name "AnimeZ")
ZBRR_PROWLARR_ANIMEZ_INDEXER_ID=0
# Categories to search (5070 = TV/Anime, 5000 = TV, 2000 = Movies)
ZBRR_PROWLARR_CATEGORIES=5070
# Optional search query filter (empty = latest releases)
ZBRR_PROWLARR_QUERY=
# HTTP request timeout in seconds (default: 30)
# ZBRR_PROWLARR_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Release Filters
# -----------------------------------------------------------------------------
# Regex filters (comma-separated)
# ZBRR_FILTERS_INCLUDE_REGEX=(?i)\b(1080p|2160p|720p)\b
# ZBRR_FILTERS_EXCLUDE_REGEX=(?i)\b(CAM|TS|R5|360p|480p)\b
# Release group whitelist (comma-separated; empty = allow all groups)
# ZBRR_FILTERS_ALLOWED_GROUPS=SubsPlease,Erai-raws,Judas,EMBER,ASW,Vodes,ToonsHub
# Target resolutions (comma-separated)
# ZBRR_FILTERS_ALLOWED_RESOLUTIONS=1080p,2160p
# Allowed sources (e.g. WEB-DL,BluRay,BDRip; empty = allow all)
# ZBRR_FILTERS_ALLOWED_SOURCES=WEB-DL,BluRay
# Allowed video codecs (e.g. HEVC,H.264,AV1; empty = allow all)
# ZBRR_FILTERS_ALLOWED_CODECS=HEVC,H.264
# Minimum seeders required on the source indexer
# ZBRR_FILTERS_MIN_SEEDERS=1
# Size bounds in bytes (default: 50 MiB min, 100 GiB max)
# ZBRR_FILTERS_MIN_SIZE_BYTES=52428800
# ZBRR_FILTERS_MAX_SIZE_BYTES=107374182400

# -----------------------------------------------------------------------------
# qBittorrent WebUI Settings (v5.2.0+ Bearer API Key)
# -----------------------------------------------------------------------------
ZBRR_QBITTORRENT_URL=http://localhost:8080
ZBRR_QBITTORRENT_API_KEY=your_qbittorrent_api_key_here
# Staging category for initial downloads (default: animez-staging)
# ZBRR_QBITTORRENT_STAGING_CATEGORY=animez-staging
# Category for tracker-signed seeding torrents (default: animez-seeding)
# ZBRR_QBITTORRENT_SEEDING_CATEGORY=animez-seeding
# Tag applied to managed torrents (default: animez-auto)
# ZBRR_QBITTORRENT_TAG=animez-auto
# Download timeout in seconds (default: 14400 = 4 hours)
# ZBRR_QBITTORRENT_DOWNLOAD_TIMEOUT_SECS=14400
# Poll interval in seconds while monitoring downloads (default: 10)
# ZBRR_QBITTORRENT_POLL_INTERVAL_SECS=10

# Path mapping: Required when qBittorrent runs in Docker/WSL/NAS and zbrr runs on Windows host.
# Maps remote download path (e.g. /downloads) to local Windows accessible path (e.g. \\qbit.lan\downloads or Z:\downloads)
# NOTE: Windows paths with backslashes must be enclosed in single quotes ('\\server\share') to avoid backslash escape syntax errors.
# ZBRR_QBITTORRENT_REMOTE_PATH_PREFIX=/downloads
# ZBRR_QBITTORRENT_LOCAL_PATH_PREFIX='\\qbit.lan\downloads'

# -----------------------------------------------------------------------------
# Media Packaging (FFmpeg, FFprobe, MediaInfo)
# -----------------------------------------------------------------------------
# Path to binaries if not in system PATH
# ZBRR_PACKAGER_FFMPEG_BIN=ffmpeg
# ZBRR_PACKAGER_FFPROBE_BIN=ffprobe
# ZBRR_PACKAGER_MEDIAINFO_BIN=mediainfo
# Number of screenshots to capture (default: 4)
# ZBRR_PACKAGER_SCREENSHOT_COUNT=4
# Screenshot positions as comma-separated fractions of duration (default: 0.15,0.35,0.55,0.75)
# ZBRR_PACKAGER_SCREENSHOT_POSITIONS=0.15,0.35,0.55,0.75
# Screenshot format: jpg, webp, or png (default: jpg).
# Using jpg (quality 2) prevents HTTP 413 Payload Too Large by keeping multipart upload under ~1.5MB.
# ZBRR_PACKAGER_SCREENSHOT_FORMAT=jpg
# Screenshot JPEG quality 1-31 (1 = best, 31 = lowest; default: 2)
# ZBRR_PACKAGER_SCREENSHOT_QUALITY=2

# -----------------------------------------------------------------------------
# Jikan (MyAnimeList) Metadata Resolver
# -----------------------------------------------------------------------------
# Set to false if api.jikan.moe times out or if MAL resolution is not needed (default: true)
ZBRR_JIKAN_ENABLED=true
# ZBRR_JIKAN_BASE_URL=https://api.jikan.moe/v4
# ZBRR_JIKAN_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# FlareSolverr Settings
# -----------------------------------------------------------------------------
ZBRR_FLARESOLVERR_URL=http://localhost:8191/v1
# Max timeout in milliseconds for FlareSolverr challenge resolution (default: 60000)
# ZBRR_FLARESOLVERR_MAX_TIMEOUT_MS=60000
# Cookies file path override (default: ~/.zbrr/cookies.json)
# ZBRR_FLARESOLVERR_COOKIES_FILE=~/.zbrr/cookies.json

# -----------------------------------------------------------------------------
# AnimeZ.to Tracker Settings
# -----------------------------------------------------------------------------
ZBRR_ANIMEZ_BASE_URL=https://animez.to
ZBRR_ANIMEZ_USERNAME=your_animez_username_here
ZBRR_ANIMEZ_PASSWORD=your_animez_password_here
# Personal ID (PID) from your animez.to profile
ZBRR_ANIMEZ_PID=your_animez_pid_here
# Optional explicit announce URL (auto-generated as https://tracker.animez.to/<PID>/announce if omitted)
ZBRR_ANIMEZ_ANNOUNCE_URL=https://tracker.animez.to/your_animez_pid_here/announce
# Optional endpoint overrides
# ZBRR_ANIMEZ_LOGIN_PATH=/login
# ZBRR_ANIMEZ_UPLOAD_PATH=/upload
# ZBRR_ANIMEZ_SEARCH_PATH=/torrents
# ZBRR_ANIMEZ_ANONYMOUS=false
# ZBRR_ANIMEZ_IMAGE_UPLOAD_MODE=direct

# Optional session cookie overrides (auto-populated into ~/.zbrr/cookies.json on login)
# If Cloudflare Turnstile blocks automated login, paste active browser cookies here:
ZBRR_ANIMEZ_SESSION_COOKIE=
ZBRR_ANIMEZ_REMEMBER_COOKIE=
ZBRR_ANIMEZ_CF_CLEARANCE=
ZBRR_ANIMEZ_USER_AGENT=
